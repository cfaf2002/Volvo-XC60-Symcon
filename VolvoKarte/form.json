{
    "elements": [
        {
            "type": "SelectInstance",
            "name": "VolvoInstance",
            "caption": "Volvo-Instanz",
            "validModules": [
                "{3E673B62-F8FD-4C29-9848-EEACA895B4F3}"
            ],
            "width": "420px"
        },
        {
            "type": "Label",
            "caption": "In der Volvo-Instanz muss „Standort abrufen“ aktiv sein (Recht location:read)."
        },
        {
            "type": "ExpansionPanel",
            "caption": "Verlauf",
            "expanded": true,
            "items": [
                {
                    "type": "CheckBox",
                    "name": "RecordHistory",
                    "caption": "Verlauf mitschreiben"
                },
                {
                    "type": "NumberSpinner",
                    "name": "HistoryDays",
                    "caption": "Verlauf aufbewahren",
                    "suffix": "Tage",
                    "minimum": 1,
                    "maximum": 90
                },
                {
                    "type": "Label",
                    "caption": "Gespeichert wird nur ein neuer Punkt, wenn sich das Auto um mehr als 30 m bewegt hat. Ausschalten stoppt das Mitschreiben, der bisherige Verlauf bleibt bis zum Löschen erhalten."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Adresse",
            "expanded": true,
            "items": [
                {
                    "type": "CheckBox",
                    "name": "ShowAddress",
                    "caption": "Straße und Ort unter der Karte anzeigen"
                },
                {
                    "type": "Label",
                    "caption": "Die Adresse wird bei OpenStreetMap (Nominatim) nachgeschlagen – nur einmal je neuem Standort, wenn sich das Auto mehr als 30 m bewegt hat. Dazu wird die Position an nominatim.openstreetmap.org übertragen. Zusätzlich gibt es die Variable „Adresse“."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Fahrzeugsymbol",
            "items": [
                {
                    "type": "Select",
                    "name": "MarkerType",
                    "caption": "Symbol auf der Karte",
                    "options": [
                        {
                            "caption": "Standard-Symbol",
                            "value": 0
                        },
                        {
                            "caption": "Fahrzeugbild von Volvo",
                            "value": 1
                        },
                        {
                            "caption": "Eigenes Foto / Bild",
                            "value": 2
                        }
                    ]
                },
                {
                    "type": "SelectFile",
                    "name": "MarkerImage",
                    "caption": "Eigenes Foto / Bild",
                    "extensions": ".jpg,.jpeg,.png,.webp,.gif"
                },
                {
                    "type": "CheckBox",
                    "name": "MarkerRound",
                    "caption": "Eigenes Bild rund zuschneiden (aus = Bild frei stehend, ideal für PNG mit transparentem Hintergrund)"
                },
                {
                    "type": "NumberSpinner",
                    "name": "MarkerSize",
                    "caption": "Bildgröße",
                    "suffix": "px",
                    "minimum": 28,
                    "maximum": 140
                },
                {
                    "type": "Label",
                    "caption": "Das Bild wird beim Übernehmen automatisch auf 256 Pixel verkleinert. Das Volvo-Fahrzeugbild braucht in der Volvo-Instanz das Recht conve:vehicle_relation."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Darstellung",
            "items": [
                {
                    "type": "CheckBox",
                    "name": "ShowHome",
                    "caption": "Zuhause als Kreis anzeigen (Standort aus Location Control)"
                },
                {
                    "type": "CheckBox",
                    "name": "DarkMap",
                    "caption": "Dunkle Karte"
                },
                {
                    "type": "NumberSpinner",
                    "name": "Zoom",
                    "caption": "Zoomstufe beim Öffnen",
                    "minimum": 3,
                    "maximum": 19
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Karte aktualisieren",
            "onClick": "VOLVOMAP_Refresh($id); echo 'Aktualisiert.';"
        },
        {
            "type": "PopupButton",
            "caption": "Verlauf löschen",
            "popup": {
                "caption": "Gespeicherten Verlauf wirklich löschen?",
                "items": [
                    {
                        "type": "Button",
                        "caption": "Ja, löschen",
                        "onClick": "VOLVOMAP_ClearHistory($id); echo 'Verlauf gelöscht.';"
                    }
                ]
            }
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Bereit"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Bitte die Volvo-Instanz auswählen"
        }
    ]
}